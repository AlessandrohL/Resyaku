@using Resyaku.Infrastructure.Authentication.Features.Users.Commands.LoginUser
@using Resyaku.Web.Common
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}
@model LoginUserCommand

<div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="row w-100">
        <div class="mb-4 w-100 text-center">
            <hr class="my-3" />
        </div>
        <div class="col-12 col-md-6 col-lg-4 mx-auto bg-white py-5 px-4 shadow rounded">
            <h5 class="text-center text-secondary mb-4 fw-bold">
                ¡Bienvenido, por favor inicia sesión!
            </h5>
            <div class="text-center">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="100"
                     height="100"
                     viewBox="0 0 24 24">
                    <path fill="#2c3e50"
                          d="M12 2C6.579 2 2 6.579 2 12s4.579 10 10 10s10-4.579 10-10S17.421 2 12 2m0 5c1.727 0 3 1.272 3 3s-1.273 3-3 3c-1.726 0-3-1.272-3-3s1.274-3 3-3m-5.106 9.772c.897-1.32 2.393-2.2 4.106-2.2h2c1.714 0 3.209.88 4.106 2.2C15.828 18.14 14.015 19 12 19s-3.828-.86-5.106-2.228" />
                </svg>
            </div>
            @if(ViewBag.AuthError is not null) 
            {
                <div class="alert alert-dismissible alert-danger" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    <span>Nombre de usuario o contraseña incorrectos</span>
                </div>
            }
            <form asp-controller="Auth" asp-action="Login" method="post">
                <div class="mb-3 @ViewData.ErrorClass("Username", "has-danger")">
                    <label for="Username" class="form-label">Nombre de usuario:</label>
                    <input asp-for="Username"
                           type="text"
                           class="form-control @ViewData.ErrorClass("Username", "is-invalid"))"
                           placeholder="Ingresa tu nombre de usuario" />
                    <span asp-validation-for="Username" class="invalid-feedback"></span>
                </div>
                <div class="mb-3 @ViewData.ErrorClass("Password", "has-danger")">
                    <label for="Password" class="form-label">Contraseña:</label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control @ViewData.ErrorClass("Password", "is-invalid")"
                           placeholder="Ingresa tu contraseña" />
                     <span asp-validation-for="Password" class="invalid-feedback"></span>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-4 py-2">
                        Iniciar sesión
                    </button>
                </div>
            </form>
        </div>
        <div class="mt-4 w-100 text-center">
            <hr class="my-3" />
            <p class="text-muted">&copy; 2024 - Resyaku</p>
        </div>
    </div>
</div>
