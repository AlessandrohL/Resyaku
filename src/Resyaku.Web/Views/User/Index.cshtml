@using Resyaku.Web.ViewModels.Users;
@model GetAllUsersViewModel;

<div class="d-flex flex-row justify-content-between">
    <h3 class="d-inline-block mb-3">Usuarios</h3>
    <div class="d-flex flex-row justify-content-between gap-2">
        <a asp-controller="User" asp-action="CreateUser" class="btn btn-success align-content-center">+ Agregar</a>
    </div>
</div>
<form asp-controller="User" asp-action="Index" method="get" class="mb-4">
    <div class="form-row d-flex flex-row gap-3 flex-wrap mb-3">
        <div class="form-group col-md-4">
            <label for="Firstname" class="mb-2">Nombres</label>
            <input type="text" class="form-control" id="Firstname" name="Firstname" value="@Model.QueryParameters.Firstname" />
        </div>
        <div class="form-group col-md-4">
            <label for="Lastname" class="mb-2">Apellidos</label>
            <input type="text" class="form-control" id="Lastname" name="Lastname" value="@Model.QueryParameters.Lastname" />
        </div>
        <div class="form-group col-md-4">
            <label for="Email" class="mb-2">Correo Electrónico</label>
            <input type="email" class="form-control" id="Email" name="Email" value="@Model.QueryParameters.Email" />
        </div>
    </div>
    <div class="d-flex flex-row gap-3">
        <button type="submit" class="btn btn-success">Filtrar</button>
        <a asp-controller="User" asp-action="Index" class="btn btn-info" id="btn-reset-filter">Restablecer filtro</a>
    </div>
</form>
<table class="table table-striped mt-4">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Nombres</th>
            <th scope="col">Correo Electrónico</th>
            <th scope="col">Roles</th>
            <th scope="col">Bloqueo Activado</th>
            <th scope="col">Teléfono</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.UserResponses.Items)
        {
            <tr>
                <th scope="row" class="align-content-center text-truncate" style="max-width: 200px">@user.UserId</th>
                <td class="text-truncate align-content-center">@user.Fullname</td>
                <td class="align-content-center">@user.Email</td>
                <td class="align-content-center">@string.Join(", ", user.Roles)</td>
                <td class="text-center align-content-center">
                    @if (user.LockoutEnabled)
                    {
                        <span class="badge bg-danger">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">No</span>
                    }
                </td>
                <td class="align-content-center">@user.PhoneNumber</td>
                <td class="align-content-center">
                    <div class="dropdown d-flex justify-content-center">
                        <button class="btn btn-secondary dropdown-toggle d-flex justify-content-center align-items-center py-3"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="User" asp-action="UpdateUser" asp-route-userId="@user.UserId">Editar</a></li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <ul class="pagination">

        @if (Model.UserResponses.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new {
                    page = Model.UserResponses.Page - 1,
                    pageSize = Model.UserResponses.PageSize,
                    Firstname = Model.QueryParameters.Firstname,
                    Lastname = Model.QueryParameters.Lastname,
                    Email = Model.QueryParameters.Email })">
                    &laquo;
                </a>
            </li>
        }

        <li class="page-item active">
            <a class="page-link" href="#">@Model.UserResponses.Page</a>
        </li>

        @if (Model.UserResponses.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new {
                    page = Model.UserResponses.Page + 1,
                    pageSize = Model.UserResponses.PageSize,
                    Firstname = Model.QueryParameters.Firstname,
                    Lastname = Model.QueryParameters.Lastname,
                    Email = Model.QueryParameters.Email })">
                    &raquo;
                </a>
            </li>
        }
    </ul>
</div>

@if (TempData["User.Created"] is not null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">@TempData["User.Created"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastElement = document.getElementById('successToast');
            if (toastElement) {
                const toast = new bootstrap.Toast(toastElement, {
                    autohide: true,
                    delay: 3000
                });
                toast.show();
            }
        });
    </script>
}
