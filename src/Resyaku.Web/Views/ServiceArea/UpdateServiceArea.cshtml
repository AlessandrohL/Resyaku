@using Resyaku.Web.Common
@using Resyaku.Web.ViewModels.ServiceAreas
@model UpdateServiceAreaViewModel

<div class="d-flex flex-row justify-content-between mb-4">
    <h3 class="d-inline-block mb-3">Actualizar área de Servicio - ID(@Model.ServiceAreaId)</h3>
</div>

<form asp-area="Admin" asp-controller="ServiceArea" asp-action="UpdateServiceArea" method="post">
    <input asp-for="@Model.ServiceAreaId" value="@Model.ServiceAreaId" type="hidden"/>
    <div class="row mb-3">
        <div class="col-6 form-group @ViewData.ErrorClass("Name", "has-danger")">
            <label for="firstname" class="mb-2">Nombre:</label>
            <input asp-for="Name"
                   id="name"
                   class="form-control @ViewData.ErrorClass("Name", "is-invalid")" 
                   value="@Model.Name"
                   />
            <span asp-validation-for="Name" class="invalid-feedback"></span>
        </div>
    </div>
    <div class="d-flex flex-row justify-content-between align-items-center mt-4">
        <a asp-controller="ServiceArea" asp-action="Index" class="text-info">Cancelar</a>
        <button type="submit" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path fill="#fff" d="M17.59 3.59c-.38-.38-.89-.59-1.42-.59H5a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V7.83c0-.53-.21-1.04-.59-1.41zM12 19c-1.66 0-3-1.34-3-3s1.34-3 3-3s3 1.34 3 3s-1.34 3-3 3m1-10H7c-1.1 0-2-.9-2-2s.9-2 2-2h6c1.1 0 2 .9 2 2s-.9 2-2 2" />
            </svg>
            <span>Guardar cambios</span>
        </button>
    </div>
</form>