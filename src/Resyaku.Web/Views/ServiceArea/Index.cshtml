@using Resyaku.Application.Features.ServiceAreas.Queries.GetAllServiceAreas
@model List<GetAllServiceAreasDto>

<div class="d-flex flex-row justify-content-between mb-4">
    <h3 class="d-inline-block mb-3">Áreas de servicio</h3>
    <div class="d-flex flex-row justify-content-between gap-2">
        <a asp-controller="ServiceArea" asp-action="CreateServiceArea" class="btn btn-success align-content-center">+ Agregar área</a>
    </div>
</div>
@if(Model.Count == 0) 
{
    <p class="text-muted">No hay áreas de servicio registrados.</p>
} 
else 
{
    <ul class="list-group">
        @foreach (var serviceArea in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                @serviceArea.Name
                <div class="align-content-center">
                    <div class="dropdown d-flex justify-content-center">
                        <button class="btn btn-secondary dropdown-toggle d-flex justify-content-center align-items-center py-3"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                        </button>
                        <ul class="dropdown-menu">
                            <li><a asp-controller="ServiceArea" asp-action="UpdateServiceArea" asp-route-serviceAreaId="@serviceArea.Id" class="dropdown-item">Editar</a></li>
                        </ul>
                    </div>
                </div>
            </li>
        }
    </ul>
}